<?xml version="1.0" encoding="utf-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Music" targetNamespace="http://example.com/yandex-music" exporter="OpenAI" exporterVersion="1.0">
  <bpmn:process id="Process_NextTrack" name="Яндекс Музыка — рекомендация следующего трека" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_User" name="Пользователь">
        <bpmn:flowNodeRef>Activity_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Click</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Listen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_React</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Система рекомендаций">
        <bpmn:flowNodeRef>Activity_Data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Candidates</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ML</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Quality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_SelectML</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Fallback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Activity_Start" name="Начало">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_Click" name="Нажать «Моя волна»">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_Data" name="Получить данные пользователя">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_Candidates" name="Найти треки-кандидаты">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Activity_ML" name="Запустить ML-модель рекомендаций">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Activity_Success" name="Модель ответила?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Activity_Quality" name="Оценка проходит порог?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_SelectML" name="Выбрать трек по оценке модели">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_Fallback" name="Выбрать трек по другим правилам">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Activity_Merge" gatewayDirection="Converging">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_Send" name="Отправить выбранный трек">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_Listen" name="Прослушать трек">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_React" name="Поставить лайк или пропустить">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_Save" name="Сохранить реакцию для будущего обучения">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Activity_End" name="Конец">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Activity_Start" targetRef="Activity_Click"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_Click" targetRef="Activity_Data"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Activity_Data" targetRef="Activity_Candidates"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Activity_Candidates" targetRef="Activity_ML"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Activity_ML" targetRef="Activity_Success"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Activity_Success" targetRef="Activity_Quality" name="Да"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Activity_Success" targetRef="Activity_Fallback" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Activity_Quality" targetRef="Activity_SelectML" name="Да"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Activity_Quality" targetRef="Activity_Fallback" name="Нет"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_SelectML" targetRef="Activity_Merge"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_Fallback" targetRef="Activity_Merge"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Activity_Merge" targetRef="Activity_Send"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Activity_Send" targetRef="Activity_Listen"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Activity_Listen" targetRef="Activity_React"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Activity_React" targetRef="Activity_Save"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Activity_Save" targetRef="Activity_End"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_NextTrack">
      <bpmndi:BPMNShape id="Lane_User_di" bpmnElement="Lane_User" isHorizontal="true">
